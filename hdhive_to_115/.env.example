# HDHive browser session cookie string (from DevTools → Application → Cookies)
# Include at least: token, refresh_token, csrf_access_token, hdh_uid
HDHIVE_COOKIE=

# Optional domain overrides
HDHIVE_BASE_URL=https://hdhive.com

# Skip unlock if cost > this (set high to never skip)
HDHIVE_MAX_POINTS=4

# Headless browser (1=yes, 0=show window for debugging)
HDHIVE_HEADLESS=1

# 115 Cookie (full Cookie header value)
ENV_115_COOKIES=

# Target 115 folder CID (0 = root)
HDHIVE_115_PID=0

# Delay seconds before 115 receive (rate limit friendliness)
TRANSFER_DELAY=2

# Optional: TMDB API key for reliable title search (want command).
# Free key: https://www.themoviedb.org/settings/api
# If empty, tool falls back to HDHive on-site search UI.
TMDB_API_KEY=
